# itglue-mcp configuration. Copy to .env for LOCAL dev only.
# Production values live in the Portainer stack environment — never ship a .env.

# ---------------------------------------------------------------- IT Glue API
# WARNING: this key has full write AND delete rights in IT Glue. That was
# verified, not assumed (PATCH/DELETE against a bogus id return 404 "Record not
# found", which only happens after the mutation is authorized). IT Glue does not
# issue read-scoped classic API keys, so the read-only guarantee is entirely in
# this codebase. Treat the key as highly privileged.
ITGLUE_API_KEY=ITG.xxxxxxxxxxxxxxxxxxxxxxxx
ITGLUE_BASE_URL=https://api.itglue.com
ITGLUE_SUBDOMAIN_URL=https://your-company.itglue.com
ITGLUE_TIMEOUT=40
ITGLUE_SYNC_DELAY=0.05

# ------------------------------------------------------------ safety toggles
# Password VALUES and password NOTES are NEVER returned, at any setting, and are
# not configurable. IT Glue also refuses this key a value (401 on
# ?show_password=true). This toggle only controls the USERNAME field, which is
# half a credential — leave false unless the team decides otherwise.
ITGLUE_INCLUDE_USERNAME=false
# Drop records IT Glue itself marks restricted (limited visibility).
ITGLUE_HONOR_RESTRICTED=true
# Archived records are stale by definition; excluded from search by default.
ITGLUE_INCLUDE_ARCHIVED=false

# -------------------------------------------------------------- local mirror
# Required, not an optimisation: IT Glue's filter[name] is exact-match only, so
# substring/fuzzy search has to run locally.
ITGLUE_CORE_TTL=21600       # 6h  — ~7k structured records, ~10 API calls
ITGLUE_DOCS_TTL=86400       # 24h — ~300 documents, ~400 API calls
ITGLUE_WARM_DOCS_ON_START=true
ITGLUE_MAX_RESULTS=25

# ------------------------------------------------------------- Entra ID auth
# From scripts/setup_entra_app.ps1 output.
MCP_AUTH_ENABLED=true
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# MUST be the exact /mcp URL (playbook rule 2) or sign-in fails AADSTS9010010.
ENTRA_IDENTIFIER_URI=https://itglue-mcp.example.com/mcp
MCP_BASE_URL=https://itglue-mcp.example.com
ENTRA_SCOPE_NAME=access_as_user
ENTRA_REQUIRED_SCOPES=access_as_user
# Advertise offline_access so Claude gets a refresh token and renews silently.
ITGLUE_ADVERTISE_OFFLINE_ACCESS=true

# ----------------------------------------------------------------- listener
MCP_HOST=0.0.0.0
MCP_PORT=8000

# For local MCP Inspector testing ONLY — never expose an auth-off server:
#   MCP_AUTH_ENABLED=false

# --- Telemetry (mcp-telemetry-kit) -------------------------------------------
# Sends per-tool-call cost metrics to the OTEL collector, which Grafana reads.
# Set MCP_TELEMETRY_ENABLED=false to make the middleware inert.
MCP_TELEMETRY_ENABLED=true
OTEL_SERVICE_NAME=itglue-mcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.0.0.10:4318
# Authorization=Bearer <collector token> — from the Portainer stack env.
OTEL_EXPORTER_OTLP_HEADERS=
